      "fullName": "validate_input",
      "genericSignature": "<empty>",
      "code": "static int validate_input(const char *input)\n{\n    if (input == NULL || input[0] == '\\0') {\n        return RESULT_INVALID;\n    }\n    if (strlen(input) > 32U) {\n        return RESULT_TOO_LONG;\n    }\n    return RESULT_OK;\n}",
      "isExternal": false,
      "lineNumber": 11,
      "columnNumber": 1,
      "order": 1,
      "filename": "demo.c"
    },
    {
      "name": "checksum",
      "astParentFullName": "demo.c:<global>",
      "_id": 107374182403,
      "signature": "unsigned(char*)",
      "astParentType": "TYPE_DECL",
      "lineNumberEnd": 33,
      "_label": "METHOD",
      "columnNumberEnd": 1,
      "fullName": "checksum",
      "genericSignature": "<empty>",
      "code": "static unsigned checksum(const char *input)\n{\n    unsigned value = 0U;\n    for (size_t index = 0U; input[index] != '\\0'; ++index) {\n        if (input[index] >= 'a' && input[index] <= 'z') {\n            value += (unsigned)(input[index] - 'a' + 1);\n        } else {\n            value += (unsigned)(unsigned char)input[index];\n        }\n    }\n    return value;\n}",
      "isExternal": false,
      "lineNumber": 22,
      "columnNumber": 1,
      "order": 1,
      "filename": "demo.c"
    },
    {
      "name": "safe_sink",
      "astParentFullName": "demo.c:<global>",
      "_id": 107374182404,
      "signature": "void(unsigned)",
      "astParentType": "TYPE_DECL",
      "lineNumberEnd": 38,
      "_label": "METHOD",
      "columnNumberEnd": 1,
      "fullName": "safe_sink",
      "genericSignature": "<empty>",
      "code": "static void safe_sink(unsigned value)\n{\n    printf(\"checksum=%u\\n\", value);\n}",
      "isExternal": false,
      "lineNumber": 35,
      "columnNumber": 1,
      "order": 1,
      "filename": "demo.c"
    },
    {
      "name": "unsafe_sink",
      "astParentFullName": "demo.c:<global>",
      "_id": 107374182405,
      "signature": "void(char*)",
      "astParentType": "TYPE_DECL",
      "lineNumberEnd": 44,
      "_label": "METHOD",
      "columnNumberEnd": 1,
      "fullName": "unsafe_sink",
      "genericSignature": "<empty>",
      "code": "static void unsafe_sink(const char *value)\n{\n    /* Deliberately unsafe but harmless: demonstrates an unsanitized source-to-sink path. */\n    printf(\"raw=%s\\n\", value);\n}",
      "isExternal": false,
      "lineNumber": 40,
      "columnNumber": 1,
      "order": 1,
      "filename": "demo.c"
    },
    {
      "name": "process_request",
      "astParentFullName": "demo.c:<global>",
      "_id": 107374182406,
      "signature": "int(char*,int)",
      "astParentType": "TYPE_DECL",
      "lineNumberEnd": 58,
      "_label": "METHOD",
      "columnNumberEnd": 1,
      "fullName": "process_request",
      "genericSignature": "<empty>",
      "code": "static int process_request(const char *input, int unsafe_mode)\n{\n    int status = validate_input(input);\n    if (status != RESULT_OK) {\n        fprintf(stderr, \"validation failed: %d\\n\", status);\n        return status;\n    }\n\n    unsigned value = checksum(input);\n    (void)unsafe_mode;\n    safe_sink(value);\n    return RESULT_OK;\n}",
      "isExternal": false,
      "lineNumber": 46,
      "columnNumber": 1,
      "order": 1,
      "filename": "demo.c"
    },
    {
      "name": "main",
      "astParentFullName": "demo.c:<global>",
      "_id": 107374182407,
